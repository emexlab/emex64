syntax "emex64" "\.(e64|e64inc)$"

# Numbers
color red "\b(0x|0b)[0-9A-Fa-f]+\b"
color red "\b[0-9]+\b"

# Opcodes
color brightgreen "\b(hlt|nop|mov|swp|swpz|push|pop|ldb|ldw|ldd|ldq|stb|stw|std|stq|add|sub|mul|div|idiv|mod|inc|dec|not|and|or|xor|shr|shl|ror|rol|pdep|pext|bswapw|bswapd|bswapq|b|cmp|be|bne|blt|bgt|ble|bge|bz|bnz|bl|ret|iret|clr|blw|wret|cmov|cmovb)\b"

# Directives
color magenta "\b(db|dw|dd|dq|df|section|extern)\b"
color magenta "\.(data|bss)\b"

# Macros
color brightmagenta "%[A-Za-z_][A-Za-z0-9_]*%"

# Registers
color cyan "\b(r([0-9]|1[0-9]|2[0-5])|rr|pc|sp|fp|cf|cr(el|ksp|exc|vec|ptb))\b"

# Constants
color brightred "\b[A-Z][A-Z0-9_]+\b"

# Strings
color brightyellow "\"([^\"\\]|\\.)*\""
color yellow "'([^'\\]|\\.)*'"

# Includations
color brightyellow "<([^\"\\]|\\.)*>"

# Comments
color blue ";.*"
