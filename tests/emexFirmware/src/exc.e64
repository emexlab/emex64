%include% <emex64.e64inc>

; generic code shit
section .data
    exception_msg db "\n-- panic --\nexception code: 0x\0"
    exception2_msg db "reason: \0"
    exception_reg_msg db "-- register dump --\n\0"

; array of all exception type names
section .data
    exception_unknown_msg db "unknown\0"
    exception_badaccess_msg db "bad access\0"
    exception_permission_msg db "permission denied\0"
    exception_badinstruction_msg db "bad instruction\0"
    exception_badarithmetic_msg db "bad arithmetic\0"
    exception_pagefault_msg db "page fault\0"
    exception_ktrr_msg db "ktrr violation\0"
    exception_type_array_msg dq exception_unknown_msg, exception_badaccess_msg, exception_permission_msg, exception_badinstruction_msg, exception_badarithmetic_msg, exception_pagefault_msg, exception_ktrr_msg

; array of all register names
section .data
    exception_pc_msg db "pc\0"
    exception_sp_msg db "sp\0"
    exception_fp_msg db "fp\0"
    exception_cf_msg db "cf\0"
    exception_fpc_msg db "fpc\0"
    exception_r0_msg db "r0\0"
    exception_r1_msg db "r1\0"
    exception_r2_msg db "r2\0"
    exception_r3_msg db "r3\0"
    exception_r4_msg db "r4\0"
    exception_r5_msg db "r5\0"
    exception_r6_msg db "r6\0"
    exception_r7_msg db "r7\0"
    exception_r8_msg db "r8\0"
    exception_r9_msg db "r9\0"
    exception_r10_msg db "r10\0"
    exception_r11_msg db "r11\0"
    exception_r12_msg db "r12\0"
    exception_r13_msg db "r13\0"
    exception_r14_msg db "r14\0"
    exception_r15_msg db "r15\0"
    exception_r16_msg db "r16\0"
    exception_r17_msg db "r17\0"
    exception_r18_msg db "r18\0"
    exception_r19_msg db "r19\0"
    exception_r20_msg db "r20\0"
    exception_r21_msg db "r21\0"
    exception_r22_msg db "r22\0"
    exception_r23_msg db "r23\0"
    exception_r24_msg db "r24\0"
    exception_r25_msg db "r25\0"
    exception_rr_msg db "rr\0"
    exception_array_reg_msg dq exception_pc_msg, exception_sp_msg, exception_fp_msg, exception_cf_msg, exception_fpc_msg, exception_r0_msg, exception_r1_msg, exception_r2_msg, exception_r3_msg, exception_r4_msg, exception_r5_msg, exception_r6_msg, exception_r7_msg, exception_r8_msg, exception_r9_msg, exception_r10_msg, exception_r11_msg, exception_r12_msg, exception_r13_msg, exception_r14_msg, exception_r15_msg, exception_r16_msg, exception_r17_msg, exception_r18_msg, exception_r19_msg, exception_r20_msg, exception_r21_msg, exception_r22_msg, exception_r23_msg, exception_r24_msg, exception_r25_msg, exception_rr_msg

_exception_str_for_code:
    cmp r0, 6
    ble .skip_unknown_force
    clr r0
.skip_unknown_force:
    mul r0, 8
    add r0, exception_type_array_msg
    ldq rr, r0
    wret

; switch table
section .data
    exception_putreg_switch dq _exception_putreg.pc, _exception_putreg.sp, _exception_putreg.fp, _exception_putreg.cf, _exception_putreg.fpc, _exception_putreg.r0, _exception_putreg.r1, _exception_putreg.r2, _exception_putreg.r3, _exception_putreg.r4, _exception_putreg.r5, _exception_putreg.r6, _exception_putreg.r7, _exception_putreg.r8, _exception_putreg.r9, _exception_putreg.r10, _exception_putreg.r11, _exception_putreg.r12, _exception_putreg.r13, _exception_putreg.r14, _exception_putreg.r15, _exception_putreg.r16, _exception_putreg.r17, _exception_putreg.r18, _exception_putreg.r19, _exception_putreg.r20, _exception_putreg.r21, _exception_putreg.r22, _exception_putreg.r23, _exception_putreg.r24, _exception_putreg.r25, _exception_putreg.rr

;
; register printing
;
; r0: reg enumerationmacro value
; r1: fp value of final iret frame
;
_exception_putreg:
    ; get the reg string
    mov r6, r1
    mul r1, r0, 8
    add r2, r1, exception_array_reg_msg ; gives the string
    add r3, r1, exception_putreg_switch ; gives the value getter handle of the switch
    ldq r4, r2
    ldq r5, r3

    ; get the reg value from frame pointer passed in r0
    ; time will hopefully fix this later
    b r5
    
.pc:
.sp:
.fp:
.cf:
.fpc:
.r0:
.r1:
.r2:
.r3:
.r4:
.r5:
.r6:
.r7:
.r8:
.r9:
.r10:
.r11:
.r12:
.r13:
.r14:
.r15:
.r16:
.r17:
.r18:
.r19:
.r20:
.r21:
.r22:
.r23:
.r24:
.r25:
    sub r8, REG_RR, r0
    mul r7, 8, r8
    add r6, r7
    ldq r0, r6
    b .get_me_tf_out_of_here
.rr:
    pop rr
    mov r0, rr
.get_me_tf_out_of_here:

    ; here r1 becomes the reg str
    ; here r2 becomes register value
    blw _puts, r4
    blw _putc, ':'
    blw _putc, ' '
    blw _putc, '0'
    blw _putc, 'x'
    blw _putbase, r0, 16
    blw _putc, '\n'
    wret

_exception_hang:
.hang:
    hlt
    b .hang

_exception_handler:
    ; return register is still from the cause of the exception
    push rr

    ; printing the exception code which
    ; is what declares the reason
    blw _puts, exception_msg
    cmovb r20, REG_CR2
    blw _putbase, r20, 16
    blw _putc, '\n'

    ; decoding exception code into an nice string representing
    ; the exact exception
    blw _puts, exception2_msg
    blw _exception_str_for_code, r20
    blw _puts, rr
    blw _putc, '\n'
    blw _putc, '\n'

    ; register dump by reading the interrupt stack frame
    blw _puts, exception_reg_msg

    mov r0, REG_PC
    mov r1, REG_RR
.loop:
    blw _exception_putreg, r0, fp
    inc r0
    cmp r0, r1
    ble .loop

    ; unregistering all interrupt handlers so that it can't do any
    ; logic after we handled the exception, as it is not safe anymore
    ; for the current boot session to serve any further interrupt.
    blw _interrupt_unregister_all

    ; resetting CREXC so it won't reloop into this exception handler
    cmov REG_CR2, 0x0

    ; manipulating interrupt stack frame
    add r0, fp, 248 ; translates to the pc register inside the interrupt stack frame
    stq r0, _exception_hang

    ; returns into our own hang loop
    iret
