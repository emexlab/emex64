%include% <emex64.e64inc>

section .bss
    pmm_master_ptr dq 1                             ; address that points at the main page
    pmm_max_pages dq 1                              ; count of pages

_pmm_page_addr:
    mul rr, r0, EMEX64_PAGE_SIZE                    ; page number by size equals address
    wret

_pmm_addr_page:
    clr r0                                          ; clearing return register to return NULL on failure
    bz r0, .end
    div rr, r0, EMEX64_PAGE_SIZE                    ; page number by size equals address
.end:
    wret

_pmm_page_get:
    clr r1, r2
    bz r0, .do_get
.page_not_null:
    div r1, r0, 8                                   ; byte index
    mod r2, r0, 8                                   ; bit index
.do_get:
    ldq r4, pmm_master_ptr
    add r1, r4
    ldb r3, r1
    shr r3, r2
    and rr, r3, 1
    wret

_pmm_page_set:
    clr r2, r3
    bz r0, .do_set
.page_not_null:
    div r2, r0, 8                                   ; byte index
    mod r3, r0, 8                                   ; bit index
.do_set:
    ldq r6, pmm_master_ptr
    add r2, r6
    ldb r4, r2
    mov r5, 1
    shl r5, r3
    not r5
    and r4, r5
    shl r1, r3
    or r4, r1
    stb r2, r4
    wret

_pmm_alloc:
    ; preparing for loop
    clr r0
    ldq r1, pmm_max_pages

    ; trying to find free page
.loop:
    blw _pmm_page_get, r0
    bz rr, .got_page
    cmp r0, r1
    bge .no_free_pages
    inc r0
    b .loop
.got_page:
    blw _pmm_page_set, r0, 0x1
    blw _pmm_page_addr, r0
    wret
.no_free_pages:
    mov rr, 0
    wret

_pmm_free:
    ; getting page from address
    blw _pmm_addr_page
    ldq r0, pmm_max_pages
    cmp rr, r0

    ; making sure page is not bigger than max pages
    bgt .end
    blw _pmm_page_set, rr, 0
.end:
    wret

_pmm_alloc_zero:
    blw _pmm_alloc
    blw _memset, rr, 0x0, 0x2000
    wret

_pmm_init:
    ; getting memory size
    blw _mc_get_mem_size                            ; asking memory controller nicely to say how large it is
    mov r0, rr                                      ; moving result to safe location

    ; dividing through page size to get count of pages that fit into the memory space
    div r0, EMEX64_PAGE_SIZE
    stq pmm_max_pages, r0                           ; store count of maximum pages

    ; getting the count of pages in use by the kernel image
    mov r1, __emex64_exec_img_end
    add r1, (EMEX64_PAGE_SIZE - 1)
    div r1, EMEX64_PAGE_SIZE                        ; get the number of pages the image is sized

    ; getting the end address of image but in the logic of our page math
    blw _pmm_page_addr, r1                          ; get end address of image
    stq pmm_master_ptr, rr                          ; store address 

    ; prepare for loop
    div r3, r0, 8                                   ; calculating memory size but in pages
    add r3, rr                                      ; adding master page pointer to offset
    add r3, 0x1FFF                                  ; adding page size - 1 (FRIDA ADD MATH OPS FOR CONSTANTS AT ASSEMBLING TIME)
    div r3, EMEX64_PAGE_SIZE                        ; do ceiling calculating
.loop:
    dec r3
    blw _pmm_page_set, r3, 0x1                       ; mark page as used
    bnz r3, .loop
.return:
    ret

_pmm_get_count:
    ldq rr, pmm_max_pages
    wret

_pmm_get_used_count:
    ; preparing for loop
    clr r0, r2
    ldq r1, pmm_max_pages

    ; trying to find free page
.loop:
    blw _pmm_page_get, r0
    bz rr, .got_page
.got_back:
    cmp r0, r1
    bge .loop_end
    inc r0
    b .loop
.got_page:
    inc r2
    b .got_back
.loop_end:
    mov rr, r2
    wret

