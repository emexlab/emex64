%include% <emex64.e64inc>

extern main.hang

section .data
    pmm_failed_msg db "[pmm] not enough memory available to safely initialize page memory management\n\0"
    pmm_init_msg db "[pmm] initialized\n\0"

section .bss
    pmm_master_ptr dq 1             ; address that points at the main page
    pmm_max_pages dq 1              ; count of usable pages

pmm_page_addr:
    mul rr, r0, EMEX64_PAGE_SIZE    ; page number by size equals address
    wret

pmm_addr_page:
    clr rr                          ; clearing return register to return NULL on failure
    bz r0, .end
    div rr, r0, EMEX64_PAGE_SIZE    ; page number by size equals address
.end:
    wret

pmm_page_get:
    clr r1, r2
    bz r0, .do_get
.page_not_null:
    div r1, r0, 8                   ; byte index
    mod r2, r0, 8                   ; bit index
.do_get:
    ldq r4, pmm_master_ptr
    add r1, r4
    ldb r3, r1
    shr r3, r2
    and rr, r3, 1
    wret

pmm_page_set:
    clr r2, r3
    bz r0, .do_set
.page_not_null:
    div r2, r0, 8                   ; byte index
    mod r3, r0, 8                   ; bit index
.do_set:
    ldq r6, pmm_master_ptr
    add r2, r6
    ldb r4, r2
    mov r5, 1
    shl r5, r3
    not r5
    and r4, r5
    shl r1, r3
    or r4, r1
    stb r2, r4
    wret

pmm_alloc:
    ; preparing for loop
    clr r0
    ldq r1, pmm_max_pages

    ; trying to find free page
.loop:
    cmp r0, r1
    bge .no_free_pages
    blw pmm_page_get, r0
    bz rr, .got_page
    inc r0
    b .loop
.got_page:
    blw pmm_page_set, r0, 0x1
    blw pmm_page_addr, r0
    wret
.no_free_pages:
    mov rr, 0
    wret

pmm_free:
    ; getting page from address
    blw pmm_addr_page; , r0    (not needed cuz provided by the caller, declaring it tho would emit more bytes)
    ldq r0, pmm_max_pages
    cmp rr, r0

    ; making sure page is not bigger than max pages
    bge .end
    blw pmm_page_set, rr, 0
.end:
    wret

pmm_alloc_zero:
    blw pmm_alloc
    blw memset, rr, 0x0, EMEX64_PAGE_SIZE
    wret

pmm_init:
    ; getting memory size
    blw mc_get_size

    ; dividing through page size to get count of pages that fit into the memory space
    div r0, rr, EMEX64_PAGE_SIZE
    stq pmm_max_pages, r0

    ; getting the count of pages in use by the kernel image
    mov r1, __emex64_exec_img_end
    add r1, (EMEX64_PAGE_SIZE - 1)
    div r1, EMEX64_PAGE_SIZE

    ; doing the bitmap math (im eepy)
    blw pmm_page_addr, r1
    stq pmm_master_ptr, rr
    add r2, r0, 7
    div r2, 8
    add r3, r2, (EMEX64_PAGE_SIZE - 1)
    div r3, EMEX64_PAGE_SIZE
    add r3, r1
    cmp r3, r0
    bgt .no_memory
    ldq r4, pmm_master_ptr
    blw memset, r4, 0x0, r2

    ; mark pages that are in use already
.loop:
    dec r3
    blw pmm_page_set, r3, 0x1
    bnz r3, .loop
    blw puts, pmm_init_msg
    ret

.no_memory:
    clr rr
    stq pmm_max_pages, rr
    blw puts, pmm_failed_msg
    DO_HANG

pmm_get_count:
    ldq rr, pmm_max_pages
    wret

pmm_get_free_count:
    ; preparing for loop
    clr r0, r2
    ldq r1, pmm_max_pages

    ; trying to find free page
.loop:
    cmp r0, r1
    bge .loop_end
    blw pmm_page_get, r0
    inc r0
    bnz rr, .loop_continue
.got_page:
    inc r2
.loop_continue:
    b .loop
.loop_end:
    mov rr, r2
    wret

pmm_get_used_count:
    blw pmm_get_count
    mov r0, rr
    blw pmm_get_free_count
    sub rr, r0, rr
    wret

