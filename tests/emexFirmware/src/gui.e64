%include% <emex64.e64inc>

section .data
    gui_line dw 0
    gui_column dw 0

gui_putc:
    push er0, er1, er2, er3, er4, er5
    blw gui_putc_real
    pop er5, er4, er3, er2, er1, er0
    wret

gui_putc_real:
    bz r0, .end

    ldw r1, gui_column
    ldw r2, gui_line
    
    mov r4, r1
    mov r5, r2
    
    inc r4
    
    mul r1, 8
    mul r2, 10
    add r2, 2
    add r1, 2
    
    cmp r0, '\n'
    be .newline

    cmp r0, '\r'
    be .return

    stw gui_column, r4
    stw gui_line, r5

    cmp r0, 127
    bgt .end

    mov r4, font_data
    mul r5, r0, 8
    add r4, r5

    clr r5
.row_loop:
    add r7, r4, r5
    ldb r6, r7

    clr r8

.col_loop:
    mov r9, 7
    sub r9, r8
    shr er0, r6, r9
    and er0, 1

    add er1, r2, r5
    cmp er1, 0
    blt .skip_pixel

    ldw er4, EMEX64_FB_REG_HEIGHT
    ldw er5, EMEX64_FB_REG_WIDTH
    
    cmp er1, er4
    bge .skip_pixel

    add er2, r1, r8
    cmp er2, 0    
    blt .skip_pixel
    cmp er2, er5
    bge .skip_pixel

    mul er3, er1, er5
    add er3, er2
    add er3, EMEX64_FB_FRAMEBUFFER
    bz er0, .draw_background
    
    stb er3, EMEX64_FB_TEXT_COLOR
    b .skip_pixel
.draw_background:
    stb er3, 0
.skip_pixel:
    inc r8
    cmp r8, 8
    blt .col_loop

    inc r5
    cmp r5, 8
    blt .row_loop

.end:
    wret

.newline:
    ; reset column
    stw gui_column, 0

    ; how many glyphs fit?
    ldw r6, EMEX64_FB_REG_HEIGHT
    div r6, 10
    dec r6

    cmp r5, r6
    bge .newline_scroll

    inc r5
    clr r4

    stw gui_line, r5

    wret

.newline_scroll:
    mov r0, 10
    b scroll_up

.return:
    stw gui_column, 0
    wret

scroll_up:
    bz r0, .end

    ldw r1, EMEX64_FB_REG_HEIGHT
    ldw r2, EMEX64_FB_REG_WIDTH
    mov r3, EMEX64_FB_FRAMEBUFFER

    clr r4

    mov er2, r0
    mul er2, r2

.row_loop:
    mov r5, r1
    sub r5, r0
    cmp r4, r5
    bge .clear_bottom
    
    mov er3, r4
    mul er3, r2
    add r9, r3, er3

    mov er4, r4
    add er4, r0
    mul er4, r2
    add er0, r3, er4

    mov er1, r2
    shr r6, er1, 3

.copy_qloop:
    bz r6, .copy_remainder

    ldq r7, er0
    stq r9, r7
    
    add er0, 8
    add r9, 8

    dec r6
    b .copy_qloop

.copy_remainder:
    and er1, 7

.rem_loop:
    bz er1, .next_row
    ldb r7, er0
    stb r9, r7
    inc er0
    inc r9
    dec er1
    b .rem_loop

.next_row:
    inc r4
    b .row_loop


.clear_bottom:
    mov r4, r1
    sub r4, r0

.clear_loop:
    cmp r4, r1
    bge .end

    mul r7, r4, r2
    add r9, r3, r7

    mov er1, r2

.clear_qloop:
    shr r6, er1, 3
    bz r6, .clear_remainder

.clear_q:
    bz r6, .clear_remainder
    stq r9, 0

    add r9, r9, 8
    dec r6
    b .clear_q

.clear_remainder:
    and er1, er1, 7

.clear_byte:
    bz er1, .next_clear
    stb r9, 0
    inc r9
    dec er1
    b .clear_byte

.next_clear:
    inc r4
    b .clear_loop

.end:
    wret
