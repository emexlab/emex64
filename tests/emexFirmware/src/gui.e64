%include% <emex64.e64inc>

section .data
    gui_line dw 0
    gui_column dw 0

gui_putc:
    push er0, er1, er2, er3, er4, er5
    bl _gui_putc
    pop er5, er4, er3, er2, er1, er0
    wret

_gui_putc:
    bz r0, .end

    ldw r1, gui_column
    ldw r2, gui_line
    
    mov r4, r1
    mov r5, r2
    
    inc r4
    
    mul r1, 8
    mul r2, 10
    add r2, 2
    add r1, 2
    
    cmp r0, '\n'
    be .newline

    cmp r0, '\r'
    be .return

    stw gui_column, r4
    stw gui_line, r5

    cmp r0, 127
    bgt .end

    mov r4, font_data
    mul r5, r0, 8
    add r4, r5

    clr r5
.row_loop:
    add r7, r4, r5
    ldb r6, r7

    clr r8

.col_loop:
    mov r9, 7
    sub r9, r8
    shr er0, r6, r9
    and er0, 1

    add er1, r2, r5
    cmp er1, 0
    blt .skip_pixel

    ldw er4, EMEX64_FB_REG_HEIGHT
    ldw er5, EMEX64_FB_REG_WIDTH
    
    cmp er1, er4
    bge .skip_pixel

    add er2, r1, r8
    cmp er2, 0    
    blt .skip_pixel
    cmp er2, er5
    bge .skip_pixel

    mul er3, er1, er5
    add er3, er2
    add er3, EMEX64_FB_FRAMEBUFFER
    bz er0, .draw_background
    
    stb er3, EMEX64_FB_TEXT_COLOR
    b .skip_pixel
.draw_background:
    stb er3, 0
.skip_pixel:
    inc r8
    cmp r8, 8
    blt .col_loop

    inc r5
    cmp r5, 8
    blt .row_loop

.end:
    ret

.newline:
    ; reset column
    stw gui_column, 0

    ; how many glyphs fit?
    ldw r6, EMEX64_FB_REG_HEIGHT
    div r6, 10
    dec r6

    cmp r5, r6
    bge .newline_scroll

    inc r5
    clr r4

    stw gui_line, r5

    ret

.newline_scroll:
    mov r0, 10
    b scroll_up

.return:
    stw gui_column, 0
    ret

scroll_up:
    bz r0, .end
    ldw r1, EMEX64_FB_REG_WIDTH
    ldw r2, EMEX64_FB_REG_HEIGHT
    mul r3, r0, r1
    sub r4, r2, r0
    mul r4, r1
    add r5, EMEX64_FB_FRAMEBUFFER, r3
    movm EMEX64_FB_FRAMEBUFFER, r5, r4
    add r5, EMEX64_FB_FRAMEBUFFER, r4
    setm r5, 0, r3
.end:
    ret
