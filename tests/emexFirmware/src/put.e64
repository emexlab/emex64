%include% <emex64.e64inc>

%ifndef% PUT_DRAW_LOGO
%define% PUT_DRAW_LOGO 0
%endif% ; PUT_DRAW_LOGO

; normal ass data for the system
section .data
%if% PUT_DRAW_LOGO
    putc_uart_logo db "\n         +++++++++++++\n        ++++++++++++++\n       +++++++++++++++\n      ++++++++++++++++\n     +++++      ++++++\n    +++++      ++++++ \n   +++++      ++++++  \n  +++++      ++++++   \n +++++      ++++++    \n+++++      ++++++     \n+++++      +++++      \n +++++      +++       \n  +++++      +        \n   +++++              \n    +++++             \n     +++++            \n      ++++++++++++++++\n       +++++++++++++++\n        ++++++++++++++\n         +++++++++++++\n\0"
    putc_copyright db "\nLightweightArchitecture(c) 2024 - 2026\nemexLabs(c) 2026\n\n\0"
    raw_logo df "./logo.raw"
%endif% ; PUT_DRAW_LOGO
    putc_sym dq gui_putc

; memory units for _put_mem
section .data
    mem_unit_b db "B\0"
    mem_unit_kb db "KB\0"
    mem_unit_mb db "MB\0"
    mem_unit_gb db "GB\0"
    mem_unit_tb db "TB\0"
    mem_unit_ptrs dq mem_unit_b, mem_unit_kb, mem_unit_mb, mem_unit_gb, mem_unit_tb

%if% PUT_DRAW_LOGO

; i know this belongs into gui.e64
draw_scaled_logo:
    push er0, er1, er2, er3, er4
    bl _draw_scaled_logo
    pop er4, er3, er2, er1, er0
    wret

_draw_scaled_logo:
    ldw r4, EMEX64_FB_REG_WIDTH
    ldw r5, EMEX64_FB_REG_HEIGHT
    mov r6, 0
.y_loop:
    cmp r6, 20
    bge .done
    mul r7, r6, 22
    add r7, raw_logo
    mov r9, 0
.x_loop:
    cmp r9, 22
    bge .x_done
    ldb er0, r7
    inc r7
    bz er0, .skip_pixel
    mov er1, 0
.sy_loop:
    cmp er1, r0
    bge .sy_done
    mul er2, r6, r0
    add er2, er1
    add er2, r2
    cmp er2, r5
    bge .sy_done
    mov er3, 0
.sx_loop:
    cmp er3, r0
    bge .sx_done
    mul er4, r9, r0
    add er4, er3
    add er4, r1
    cmp er4, r4
    bge .sx_next
    push er3
    mul er3, er2, r4
    add er3, er4
    add er3, EMEX64_FB_FRAMEBUFFER
    stb er3, er0
    pop er3
.sx_next:
    inc er3
    b .sx_loop
.sx_done:
    inc er1
    b .sy_loop
.sy_done:
.skip_pixel:
    inc r9
    b .x_loop
.x_done:
    inc r6
    b .y_loop
.done:
    ret

%endif% ; PUT_DRAW_LOGO

putc:
    ldq r1, putc_sym
    b r1

put_init:
    ldb r0, EMEX64_FB_REG_ENABLED
    bnz r0, .end_gui
.end_uart:
    stq putc_sym, uart_putc
%if% PUT_DRAW_LOGO
    blw puts, putc_uart_logo
    blw puts, putc_copyright
%endif% ; PUT_DRAW_LOGO
    ret
.end_gui:
%if% PUT_DRAW_LOGO
    blw draw_scaled_logo, 6, 15, 15    
    stw gui_line, 14
    blw puts, putc_copyright
%endif% ; PUT_DRAW_LOGO
    ret

puts:
.start:
    ldb r1, r0
    inc r0
    blw putc, r1
    bnz r1, .start
    wret
    
putbase:
    clr rr
    bnz r0, .start
    blw putc, '0'
    wret
.start:
    push 0
.loop:
    div r2, r0, r1
    mul r4, r2, r1
    sub r0, r4
    cmp r0, 10
    blt .digit
    add r0, 39
.digit:
    add r0, 48
.push:
    inc rr
    push r0
    mov r0, r2
    bnz r0, .loop
.print:
    pop r0
    blw putc
    bnz r0, .print
    wret

;
; r0: main memory amount
; r1: amount to match the units to
;
put_mem:
    push r0
    push r1
    clr r2
    pop r3
    bz r3, .auto
    mov r0, r3

.auto:
    cmp r0, 1024
    blt .unit_ok
    cmp r2, 4
    bge .unit_ok
    div r0, 1024
    inc r2
    b .auto
    
.unit_ok:
    pop r0
    mov r4, r0
    mov r3, r2
.whole_loop:
    bz r3, .whole_done
    div r0, 1024
    dec r3
    b .whole_loop

.whole_done:
    blw putbase, r0, 10

    bz r2, .suffix

    blw putc, '.'
    mov r3, r2
    mov r5, 1
.unit_sz:
    bz r3, .have_sz
    mul r5, 1024
    dec r3
    b .unit_sz

.have_sz:
    mod r4, r4, r5
    mul r6, r4, 10
    div r6, r5
    blw putbase, r6, 10

.suffix:
    mul r2, 8
    add r2, mem_unit_ptrs
    ldq r0, r2
    blw puts, r0
    blw putc, ' '
    wret
