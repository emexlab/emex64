%include% <emex64.e64inc>

%ifndef% FW_MINIMAL
%define% FW_MINIMAL 0
%endif% ; FW_MINIMAL
 
memset:
    and r1, 0xFF        ; masking set value with byte mask so it doesnt exceed expectations
    add r2, r0          ; adding base address to lenght to have the end address
    b .loop_continue
.loop:
    stb r0, r1          ; setting value at address
    inc r0
.loop_continue:
    sub r3, r2, r0      ; calculating remaining lenght
    bnz r3, .loop       ; in-case r3 is still not zero we continue
    wret

memadd:
    and r1, 0xFF        ; masking set value with byte mask so it doesnt exceed expectations
    add r2, r0          ; adding base address to lenght to have the end address
    b .loop_continue
.loop:
    ldb r4, r0          ; loading to add
    add r4, r1          ; add
    stb r0, r4          ; setting value at address
    inc r0
.loop_continue:
    sub r3, r2, r0      ; calculating remaining lenght
    bnz r3, .loop       ; in-case r3 is still not zero we continue
    wret

memsub:
    and r1, 0xFF        ; masking set value with byte mask so it doesnt exceed expectations
    add r2, r0          ; adding base address to lenght to have the end address
    b .loop_continue
.loop:
    ldb r4, r0          ; loading to sub
    sub r4, r1          ; sub
    stb r0, r4          ; setting value at address
    inc r0
.loop_continue:
    sub r3, r2, r0      ; calculating remaining lenght
    bnz r3, .loop       ; in-case r3 is still not zero we continue
    wret

memcpy:
    add r3, r0, r2      ; calculating end address of destination
.loop:
    ldb r4, r1
    stb r0, r4
    inc r0, r1
.loop_continue:
    cmp r0, r3
    blt .loop
    wret

%if% FW_MINIMAL
%else%

strlen:
    clr rr                      ; clearing return register
.loop:
    ldb r1, r0                  ; loading byte from address
    inc r0, rr                  ; incrementing address
    bnz r1, .loop               ; if not reached a null terminator yet continue till we reached one
    dec rr                      ; don't count the null terminator
    wret

strdup:
    blw strlen, r0              ; getting size of string
    blw kmalloc, [rr + 1]       ; allocating memory for string
    bz rr, .null_exception      ; null pointer checking allocation
    blw memcpy, rr, r0, r1      ; copying string over
.null_exception:
    wret

%endif% ; FW_MINIMAL
