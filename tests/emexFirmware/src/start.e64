%include% <emex64.e64inc>

%ifndef% FW_TEST_EXCEPTION
%define% FW_TEST_EXCEPTION 0
%endif% ; FW_TEST_EXCEPTION

%ifndef% FW_LOCK_KTRR
%define% FW_LOCK_KTRR 0
%endif% ; FW_LOCK_KTRR

%define% EARLY_STACK_SIZE       (EMEX64_PAGE_SIZE * 1)
%define% EARLY_STACK_TOP_SUB    (EARLY_STACK_SIZE - 8)

section .bss
    early_stack db EARLY_STACK_SIZE

section .data
    fw_font_test_msg db "[fw] firmware font test\n     ABCDEFGHIJKLMNOPQRSTUVWXYZ\n     abcdefghijklmnopqrstuvwxyz\n     0123456789\n     @#%^&*()!<>?:;\n\0"
    fw_display_msg db "[fw] display resolution: \0"
    fw_display_x_msg db " x \0"
    fw_display_unavailable db "not installed\n\0"
    fw_memory_msg db "[fw] total memory size: \0"
    fw_memory_available_msg db "[fw] memory available: \0"
    fw_8042_msg db "[fw:IC:emex8042] key event: \0"
    fw_scancode_msg  db "scancode=0x\0"
    fw_8042_mouse_msg db "[fw:IC:emex8042] mouse event: 0x\0"
    fw_ktrr_msg db "[fw] locked KTRR\n\0"
    fw_testpanic_msg db "this is a test panic string\0"

fw_8042_handler:
    push rr
    ldd r0, EMEX64_8042_REG_STATUS      ; STATUS port
    and r0, 0x01                        ; OBF (bit 0)?
    bz r0, .no_data
    ldd r1, EMEX64_8042_REG_STATUS
    and r1, 0x20
    bnz r1, .mouse_event
    
    ldd r0, EMEX64_8042_REG_DATA
    blw _puts, fw_8042_msg
    blw _puts, fw_scancode_msg
    blw _putbase, r0, 16
    blw _putc, '\n'
    b .done
    
.mouse_event:
    ldd r0, EMEX64_8042_REG_DATA
    blw _puts, fw_8042_mouse_msg
    blw _putbase, r0, 16
    blw _putc, '\n'

.done:
.no_data:
    pop rr
    iret

main:
    blw _interrupt_register_handler, EMEX64_IC_IRQ_EXCEPTION, exception_handler
    blw _interrupt_register_handler, EMEX64_IC_IRQ_8042, fw_8042_handler

    blw _puts, fw_font_test_msg

    blw _puts, fw_display_msg
    ldw r0, EMEX64_FB_REG_HEIGHT
    ldw r1, EMEX64_FB_REG_WIDTH
    bz r0, .dsp_not_installed
    blw _putbase, r1, 10
    blw _puts, fw_display_x_msg
    blw _putbase, r0, 10
    blw _putc, '\n'
    b .dsp_installed
.dsp_not_installed:
    blw _puts, fw_display_unavailable
.dsp_installed:

    blw _pmm_get_count
    mul r1, rr, EMEX64_PAGE_SIZE
    blw _pmm_get_free_count
    mul r0, rr, EMEX64_PAGE_SIZE

    blw _puts, fw_memory_msg
    blw _put_mem, r1, r1
    blw _putc, '\n'

    blw _puts, fw_memory_available_msg
    blw _put_mem, r0, r1
    blw _putc, '\n'
    blw _print_time

%if% FW_LOCK_KTRR
    blw _mc_lock_ktrr
    blw _puts, fw_ktrr_msg
%endif% ; FW_LOCK_KTRR

%if% FW_TEST_EXCEPTION
    blw panic, fw_testpanic_msg
%endif%
    
.hang:
    hlt
    b .hang

_start:
    ; will just shutdown for now
    ; if it does and your reading this
    ; the reason is that there is not
    ; enough space for the bss section
    ldq r0, EMEX64_MC_REG_SIZE
    cmp r0, __bss_end
    blt .poweroff   ; bss section does not fit, sowwy, no way to handle that 3: not enough memory is.. not enough memory

    ; early stack fixup (enough for firmware)
    add sp, early_stack, EARLY_STACK_TOP_SUB

    ; initilize bss before the early stack with zero
    ; but doing math magic to avoid corrupting our
    ; own early stack region (bruh I swere I wrote
    ; that my self, idk why the hell I write so
    ; detailed comments sometimes ;w; it's just fun
    ; to do it the right way, this is not AI generated
    ; buhuhuhuhuhu ;w;)
    ;
    ; step 1: zeroing __bss_start -> early_stack
    sub r0, early_stack, __bss_start
    blw _memset, __bss_start, 0, r0

    ; step 2: zerong early_stack + the length of early_stack -> __bss_end
    add r0, early_stack, EARLY_STACK_SIZE
    cmp r0, __bss_end
    bge .bss_done   ; nothing left to zero
    sub r1, __bss_end, r0
    blw _memset, r0, 0, r1
.bss_done:

    ; rest of the routine
    bl _put_init                                    ; checks for fb
    bl _pmm_init                                    ; initilizing page allocator

    bl _slab_init                                   ; initilizing slab allocator
    bl _interrupt_init                              ; initilizing interrupt controller
    bl main                                         ; branching to main symbol
.poweroff:
    stb EMEX64_PLATFORM_REG_PWR, 0                  ; telling platform device to turn off
    
