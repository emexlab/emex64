%include% <emex64.e64inc>

%define% FW_TONE_RATE       48000

section .data
    fw_font_test_msg db "[fw] firmware font test\n     ABCDEFGHIJKLMNOPQRSTUVWXYZ\n     abcdefghijklmnopqrstuvwxyz\n     0123456789\n     @#%^&*()!<>?:;\n\0"
    fw_display_msg db "[fw] display resolution: \0"
    fw_display_x_msg db " x \0"
    fw_display_unavailable db "not installed\n\0"
    fw_memory_msg db "[fw] total memory size: \0"
    fw_memory_available_msg db "[fw] memory available: \0"
    fw_bytes_msg db " Bytes\n\0"
    fw_panic_msg db "[fw] causing panic by division through zero\n\0"
    fw_8042_msg db "[fw:IC:emex8042] key event: \0"
    fw_scancode_msg  db "scancode=0x\0"
    fw_8042_mouse_msg db "[fw:IC:emex8042] mouse event: 0x\0"
    fw_ktrr_msg db "[fw] locked KTRR\n\0"

_fw_8042_handler:
    ldd r0, 0x002000000000C008
    and r0, 0x01
    bz r0, .no_data
    ldd r1, 0x002000000000C008
    and r1, 0x20
    bnz r1, .mouse_event

    ldd r0, 0x002000000000C000
    blw _puts, fw_8042_msg
    blw _puts, fw_scancode_msg
    blw _putbase, r0, 16
    blw _putc, '\n'
    b .done

.mouse_event:
    ldd r0, 0x002000000000C000
    blw _puts, fw_8042_mouse_msg
    blw _putbase, r0, 16
    blw _putc, '\n'

.done:
.no_data:
    iret


_fw_start:
    blw _interrupt_register_handler, IRQ_EXCEPTION, _exception_handler
    blw _interrupt_register_handler, IRQ_8042, _fw_8042_handler

    blw _puts, fw_font_test_msg

    blw _puts, fw_display_msg
    ldw r0, FB_HEIGHT
    ldw r1, FB_WIDTH
    bz r0, .dsp_not_installed
    blw _putbase, r1, 10
    blw _puts, fw_display_x_msg
    blw _putbase, r0, 10
    blw _putc, '\n'
    b .dsp_installed
.dsp_not_installed:
    blw _puts, fw_display_unavailable
.dsp_installed:

    blw _mc_get_mem_size
    mov r1, rr
    sub r0, r1, __emex64_exec_img_end

    blw _puts, fw_memory_msg
    blw _put_mem, r1, r1
    blw _putc, '\n'

    blw _puts, fw_memory_available_msg
    blw _put_mem, r0, r1
    blw _putc, '\n'

    blw _print_time

    blw _mc_lock_ktrr
    blw _puts, fw_ktrr_msg

    ; init AC97 codec at 48000 Hz
    blw _ac97_init, FW_TONE_RATE

.hang:
    hlt
    b .hang

; main setup routine
_start:
    ldq r0, MCSIZE
    sub r0, 8
    mov sp, r0

    blw _put_init
    blw _pmm_init
    blw _slab_init
    blw _interrupt_init
    bl _fw_start
.poweroff:
    stb PLATFORM_PWR, 0
