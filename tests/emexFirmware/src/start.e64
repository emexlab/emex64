%include% <emex64.e64inc>

%ifndef% FW_TEST_EXCEPTION
%define% FW_TEST_EXCEPTION 0
%endif% ; FW_TEST_EXCEPTION

%define% FW_TONE_RATE   48000

section .data
    fw_font_test_msg db "[fw] firmware font test\n     ABCDEFGHIJKLMNOPQRSTUVWXYZ\n     abcdefghijklmnopqrstuvwxyz\n     0123456789\n     @#%^&*()!<>?:;\n\0"
    fw_display_msg db "[fw] display resolution: \0"
    fw_display_x_msg db " x \0"
    fw_display_unavailable db "not installed\n\0"
    fw_memory_msg db "[fw] total memory size: \0"
    fw_memory_available_msg db "[fw] memory available: \0"
    fw_8042_msg db "[fw:IC:emex8042] key event: \0"
    fw_scancode_msg  db "scancode=0x\0"
    fw_8042_mouse_msg db "[fw:IC:emex8042] mouse event: 0x\0"
    fw_ktrr_msg db "[fw] locked KTRR\n\0"

_fw_8042_handler:
    ;ldq r3, putc_sym
    ;stq putc_sym, _uart_putc

    ldd r0, EMEX64_8042_REG_STATUS      ; STATUS port
    and r0, 0x01                        ; OBF (bit 0)?
    bz r0, .no_data
    ldd r1, EMEX64_8042_REG_STATUS
    and r1, 0x20
    bnz r1, .mouse_event
    
    ldd r0, EMEX64_8042_REG_DATA
    blw _puts, fw_8042_msg
    blw _puts, fw_scancode_msg
    blw _putbase, r0, 16
    blw _putc, '\n'
    b .done
    
.mouse_event:
    ldd r0, EMEX64_8042_REG_DATA
    blw _puts, fw_8042_mouse_msg
    blw _putbase, r0, 16
    blw _putc, '\n'

.done:
.no_data:
    ;stq putc_sym, r3
    iret

_main:
    blw _interrupt_register_handler, EMEX64_IC_IRQ_EXCEPTION, _exception_handler
    blw _interrupt_register_handler, EMEX64_IC_IRQ_8042, _fw_8042_handler

    blw _mc_lock_ktrr
    blw _puts, fw_ktrr_msg

    blw _puts, fw_font_test_msg

    blw _puts, fw_display_msg
    ldw r0, EMEX64_FB_REG_HEIGHT
    ldw r1, EMEX64_FB_REG_WIDTH
    bz r0, .dsp_not_installed
    blw _putbase, r1, 10
    blw _puts, fw_display_x_msg
    blw _putbase, r0, 10
    blw _putc, '\n'
    b .dsp_installed
.dsp_not_installed:
    blw _puts, fw_display_unavailable
.dsp_installed:

    blw _mc_get_mem_size
    mov r1, rr
    sub r0, r1, __emex64_exec_img_end

    blw _puts, fw_memory_msg
    blw _put_mem, r1, r1
    blw _putc, '\n'

    blw _puts, fw_memory_available_msg
    blw _put_mem, r0, r1
    blw _putc, '\n'
    
    blw _print_time

%if% FW_TEST_EXCEPTION
    cmov REG_CR0, 0x0
    cmov REG_CR0, 0x2
%endif%
    
.hang:
    hlt
    b .hang

; main setup routine
_start:
    ; early stack fixup
    ldq r0, EMEX64_MC_REG_SIZE
    sub sp, r0, 8

    bl _put_init                                    ; checks for fb
    bl _pmm_init                                    ; initilizing page allocator

    ; actual stack fixup
    blw _pmm_alloc                                  ; a bit small lmfao
    add sp, rr, 0x1FFE
    
    bl _slab_init                                   ; initilizing slab allocator
    bl _interrupt_init                              ; initilizing interrupt controller
    bl _main                                        ; branching to main symbol
.poweroff:
    stb EMEX64_PLATFORM_REG_PWR, 0                  ; telling platform device to turn off
    
