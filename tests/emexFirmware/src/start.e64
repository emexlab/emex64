%include% <emex64.e64inc>

%ifndef% FW_TEST_EXCEPTION
%define% FW_TEST_EXCEPTION 0
%endif% ; FW_TEST_EXCEPTION

%ifndef% FW_HOOK_TEST
%define% FW_HOOK_TEST 0
%endif% ; FW_HOOK_TEST

%ifndef% FW_LOCK_KTRR
%define% FW_LOCK_KTRR 0
%endif% ; FW_LOCK_KTRR

%if% FW_HOOK_TEST
%undef% FW_LOCK_KTRR
%define% FW_LOCK_KTRR 0
%endif% ; FW_HOOK_TEST

%ifndef% FW_MINIMAL
%define% FW_MINIMAL 0
%endif% ; FW_MINIMAL

%if% FW_MINIMAL
%define% FW_HOOK_TEST 0 ; not part of the code
%define% FW_LOCK_KTRR 0 ; dangerous due to old magic (unaligned pages)
%endif% ; FW_MINIMAL

%if% FW_MINIMAL
%define% EARLY_STACK_SIZE       (EMEX64_PAGE_SIZE / 10)
%else%
%define% EARLY_STACK_SIZE       (EMEX64_PAGE_SIZE * 1)
%endif% ; FW_MINIMAL
%define% EARLY_STACK_TOP_SUB    (EARLY_STACK_SIZE - 8)

section .bss
    early_stack db EARLY_STACK_SIZE

section .data
    fw_display_msg db "[fw] display resolution: \0"
    fw_display_x_msg db " x \0"
    fw_display_unavailable db "not installed\n\0"
    fw_memory_msg db "[fw] memory installed: \0"
    fw_memory_available_msg db "[fw] memory available: \0"
    fw_8042_msg db "[8042] unrecognized key event: \0"
    fw_scancode_msg  db "scancode=0x\0"
    fw_8042_mouse_msg db "[8042] mouse event: 0x\0"
    fw_ktrr_msg db "[fw] locked KTRR\n\0"
    fw_testpanic_msg db "this is a test panic string\0"
    fw_interrupted_msg db "\r[fw] interrupted: \0"
    fw_interrupted_suffix_msg db " times\0"
    fw_entropy_msg db "[fw] entropy test: 0x\0"

section .data
    meow_cnt dq (0 - 1) ; underflow so that the hang in main does null it

extern kdb_handler
extern redirect_symbol

section .data
    meow_msg db "meow!\0"

putbase_redirect:
    blw puts, meow_msg
    wret

main:
    blw interrupt_register_handler, EMEX64_IC_IRQ_EXCEPTION, exception_handler
    blw interrupt_register_handler, EMEX64_IC_IRQ_8042, kdb_handler

    blw puts, fw_display_msg
    ldw r0, EMEX64_FB_REG_HEIGHT
    ldw r1, EMEX64_FB_REG_WIDTH
    bz r0, .dsp_not_installed
    blw putbase, r1, 10
    blw puts, fw_display_x_msg
    blw putbase, r0, 10
    blw putc, '\n'
    b .dsp_installed
.dsp_not_installed:
    blw puts, fw_display_unavailable
.dsp_installed:

    blw pmm_get_count
    mul r1, rr, EMEX64_PAGE_SIZE
    blw pmm_get_free_count
    mul r0, rr, EMEX64_PAGE_SIZE

    blw puts, fw_memory_msg
    blw put_mem, r1, r1
    blw putc, '\n'

    blw puts, fw_memory_available_msg
    blw put_mem, r0, r1
    blw putc, '\n'
    blw print_time

    blw puts, fw_entropy_msg
    rdrnd r0
    blw putbase, r0, 16
    blw putc, '\n'

%if% FW_LOCK_KTRR
    blw mc_lock_ktrr
    blw puts, fw_ktrr_msg
%endif% ; FW_LOCK_KTRR

%if% FW_TEST_EXCEPTION
    blw panic, fw_testpanic_msg
%endif% ; FW_TEST_EXCEPTION

    cmov REG_CREL, 1

%if% FW_HOOK_TEST
    blw redirect_symbol, putbase, putbase_redirect
%endif% ; FW_HOOK_TEST

    blw putc, '\n'
    blw disasm_sym, main, [.end - main]
    blw putc, '\n'

.hang:
    ldq r0, meow_cnt
    blw puts, fw_interrupted_msg
    inc r0
    blw putbase, r0, 10
    blw puts, fw_interrupted_suffix_msg
    stq meow_cnt, r0
    hlt
    b .hang
.end:

_start:
    ; will just shutdown for now
    ; if it does and your reading this
    ; the reason is that there is not
    ; enough space for the bss section
    ldq r0, EMEX64_MC_REG_SIZE
    cmp r0, __bss_end
    blt .poweroff   ; bss section does not fit, sowwy, no way to handle that 3: not enough memory is.. not enough memory

    ; early stack fixup (enough for firmware)
    add sp, early_stack, EARLY_STACK_TOP_SUB

    ; initilize bss before the early stack with zero
    ; but doing math magic to avoid corrupting our
    ; own early stack region (bruh I swere I wrote
    ; that my self, idk why the hell I write so
    ; detailed comments sometimes ;w; it's just fun
    ; to do it the right way, this is not AI generated
    ; buhuhuhuhuhu ;w;)
    ;
    ; step 1: zeroing __bss_start -> early_stack
    blw memset, __bss_start, 0, [early_stack - __bss_start]

    ; step 2: zeroing early_stack + the length of early_stack -> __bss_end
    add r0, early_stack, EARLY_STACK_SIZE
    cmp r0, __bss_end
    bge .bss_done   ; nothing left to zero
    blw memset, r0, 0, [__bss_end - r0]
.bss_done:

    ; rest of the routine
    bl put_init                                     ; checks for fb
    bl pmm_init                                     ; initilizing page allocator
%if% FW_MINIMAL
%else%
    bl slab_init                                    ; initilizing slab allocator
%endif% ; FW_MINIMAL
    bl interrupt_init                               ; initilizing interrupt controller
    bl main                                         ; branching to main symbol
.poweroff:
    stq EMEX64_PLATFORM_REG_PWR, 0                  ; telling platform device to turn off    
