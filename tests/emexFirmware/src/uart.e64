%include% <emex64.e64inc>

_uart_putc:
.start:
    ldd r1, EMEX64_UART_REG_STATUS
    and r1, EMEX64_UART_STATUS_TX_EMPTY
    bz r1, .start
    std EMEX64_UART_REG_DATA, r0
    wret

_uart_getc:
.start:
    ldd r1, EMEX64_UART_REG_STATUS
    and r1, EMEX64_UART_STATUS_RX_READY
    bz r1, .start
    ldd rr, EMEX64_UART_REG_DATA
    wret
