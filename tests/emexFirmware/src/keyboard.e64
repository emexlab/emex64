%include% <emex64.e64inc>

section .bss
    kbd_state_msg db 256

section .data
    kbd_8042_msg db "[8042] unrecognized key event: \0"
    kbd_scancode_msg  db "scancode=0x\0"

kdb_handler:
    push rr
    ldq rr, putc_sym
    push rr
    stq putc_sym, uart_putc

    ldq r0, EMEX64_8042_REG_STATUS      ; STATUS port
    and r0, 0x01                        ; OBF (bit 0)?
    bz r0, .no_data
    ldq r1, EMEX64_8042_REG_STATUS
    and r1, 0x20
    bnz r1, .done

    ldq r0, EMEX64_8042_REG_DATA
    blw puts, kbd_8042_msg
    blw puts, kbd_scancode_msg
    blw putbase, r0, 16
    blw putc, '\n'
    b .done

.done:
.no_data:
    pop rr
    stq putc_sym, rr
    pop rr
    iret
