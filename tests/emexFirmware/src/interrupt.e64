%include% <emex64.e64inc>

%ifndef% FW_MINIMAL
%define% FW_MINIMAL 0
%endif% ; FW_MINIMAL

%if% FW_MINIMAL
%define% BSS_KERNEL_STACK_SIZE      (EMEX64_PAGE_SIZE / 10)
%define% BSS_KERNEL_STACK_TOP_SUB   (BSS_KERNEL_STACK_SIZE - 8)

section .bss
    kernel_stack db BSS_KERNEL_STACK_SIZE
%endif% ; FW_MINIMAL

section .bss
    ivec dq 64

section .data
    ic_failed_msg db "[ic] out of memory: can't allocate memory for kernel stack pointer\n\0"
    ic_init_msg db "[ic] initialized\n\0"

interrupt_init:
%if% FW_MINIMAL
    add rr, kernel_stack, BSS_KERNEL_STACK_TOP_SUB
    cmov REG_CR1, rr
%else%
    ; allocate kernel stack for the interrupt handlers
    blw pmm_alloc
    bz rr, .failed
    add rr, (EMEX64_PAGE_SIZE - 8)
    cmov REG_CR1, rr
%endif% ; FW_MINIMAL

    ; setting up vector table onto interrupt controller
    stq EMEX64_IC_REG_VECTOR, ivec
    stq EMEX64_IC_REG_ENABLED, 0x0
    stq EMEX64_IC_REG_CTRL, 1
    blw puts, ic_init_msg
    ret
.failed:
    blw puts, ic_failed_msg
    DO_HANG

interrupt_register_handler:
    ; calculate interrupt vector handler slot address
    mul r2, r0, 8   ; vector table offset
    add r2, ivec    ; vector table base

    ; insert into vector table
    stq r2, r1      ; set handler into vector table

    ; now calculate bit and or it
    ldq r2, EMEX64_IC_REG_ENABLED
    shl r1, 0x1, r0
    or r2, r1
    stq EMEX64_IC_REG_ENABLED, r2
    wret

interrupt_unregister_handler:
    ; calculate interupt vector handler slot address
    mul r1, r0, 8   ; vector table offset
    add r1, ivec    ; vector table base

    ; remove handler from vector table
    stq r1, 0x0     ; zero out vector table handler address

    ; now calculate bit and or it
    ldq r2, EMEX64_IC_REG_ENABLED
    shl r1, 0x1, r0
    not r1
    and r2, r1
    stq EMEX64_IC_REG_ENABLED, r2
    wret

interrupt_unregister_all:
    mov r0, 63
.loop:
    dec r0
    blw interrupt_unregister_handler, r0
    bnz r0, .loop
    wret
