%include% <emex64.e64inc>

extern redirect_symbol

; it works by overriding the first instructions with a branch and a givven address
redirect_symbol:
    stb r0, 0b00100110              ; emitting kE64OpcodeB
    stb [r0 + 1], 0b0111            ; emitting kE64ParameterCodingAddr64 (don't have to care about the rest)
    stq [r0 + 2], r1                ; shall roughly end up at the ADDR64
    wret
