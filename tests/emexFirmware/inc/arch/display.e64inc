%ifndef% ARCH_DISPLAY_E64INC
%define% ARCH_DISPLAY_E64INC

%define% FB_BASE            0x0030000000000000
%define% FB_ENABLED         FB_BASE
%define% FB_HEIGHT          (FB_BASE + 0x08)
%define% FB_WIDTH           (FB_BASE + 0x10)
%define% FB_FRAMEBUFFER     (FB_BASE + 0x18)

%define% FB_TEXT_COLOR      0xFF

%endif% ; ARCH_DISPLAY_E64INC
