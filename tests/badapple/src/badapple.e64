%ifdef% MINIMAL
%include% <arch/display.e64inc>
%include% <arch/platform.e64inc>
%else%
%include% <emex64.e64inc>
%endif% ; MINIMAL

%define% VFB_HEIGHT      256
%define% VFB_WIDTH       256
%define% VFB_SIZE        0x10000
%define% VIDEO_FRAMES    6520

%define% AUDIO_RATE           22050
%define% AUDIO_CHUNK_SAMPLES  1470        ; 2 video frames worth
%define% AUDIO_CHUNK_BYTES    5880        ; 1470 * 4
%define% AUDIO_BDL_ENTRIES    32
%define% AUDIO_BDL_FILL       31          ; slots to fill per refill (32-1 gap)
%define% AUDIO_BDL_MASK       0x1F
%define% AUDIO_TOTAL_CHUNKS   3260        ; ceil(6520 frames / 2)

section .data
    badapple_bitmap df "../vid.bitmask"
    badapple_audio  df "../audio.raw"
%ifdef% BENCHMARK
    result_msg db "Timer Ticks: \0"
%endif%

%ifdef% FULL
_timer_handler:
    iret
%endif%

_start:
%ifndef% MINIMAL
    ldq r0, EMEX64_MC_REG_SIZE
    sub sp, r0, 8
%endif% ; MINIMAL

%ifdef% BENCHMARK
    bl put_init
    stw gui_line, 0

    stq EMEX64_TIMER_REG_COMPARE, 0xFFFFFFFFFFFFFFFF
    stq EMEX64_TIMER_REG_CTRL, 0x7
%endif%

%ifdef% FULL
    bl pmm_init
    bl interrupt_init
%endif%
%ifdef% BENCHMARK
    bl pmm_init
    bl interrupt_init
%endif%

%ifdef% FULL
    blw interrupt_register_handler, EMEX64_IC_IRQ_TIMER, _timer_handler

    ldq r0, EMEX64_TIMER_REG_FREQ
    div r0, 30
    stq EMEX64_TIMER_REG_COMPARE, r0
    stq EMEX64_TIMER_REG_COUNT, 0
    stq EMEX64_TIMER_REG_CTRL, 0x7
%endif%

    ldb r0, EMEX64_FB_REG_ENABLED
    bz r0, .end

    ldw er0, EMEX64_FB_REG_WIDTH

.video_entry:
    add r1, EMEX64_FB_FRAMEBUFFER, VFB_SIZE

.video_playback:
    mov r2, badapple_bitmap
    mov r5, 0
.video_frame_next:
%ifdef% FULL
    hlt
%endif%

    cmp r5, VIDEO_FRAMES
%ifdef% BENCHMARK
    bgt .end
%else%
    bgt .video_playback
%endif%
    mov r0, EMEX64_FB_FRAMEBUFFER

.video_frame_draw:
    ldb r3, r2
    pdep r4, r3, 0x0101010101010101
    mul r4, 0xFF
    bswapq r4

%if% VFB_ENABLED
    sub er1, r0, EMEX64_FB_FRAMEBUFFER
    shr er2, er1, 8
    and er4, er1, 0xFF
    mul er5, er2, er0
    add er5, er4
    add er5, EMEX64_FB_FRAMEBUFFER
    stq er5, r4
%else%
    stq r0, r4
%endif%

    add r0, 8
    inc r2

    cmp r0, r1
    blt .video_frame_draw
    inc r5
    b .video_frame_next

.end:
%ifdef% BENCHMARK
    ldq r0, EMEX64_TIMER_REG_COUNT
    blw puts, result_msg
    blw putbase, r0, 10
    blw putc, ' '
    blw putc, '('
    ldq r0, EMEX64_TIMER_REG_FREQ
    blw putbase, r0, 10
    blw putc, 'H'
    blw putc, 'Z'
    blw putc, ')'
    blw putc, '\n'

.no_end:
    hlt
    b .no_end
%endif%
    stb EMEX64_PLATFORM_REG_PWR, 0
