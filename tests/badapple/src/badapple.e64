%include% <emex64.e64inc>

%define% VFB_HEIGHT      256
%define% VFB_WIDTH       256
%define% VFB_SIZE        0x10000
%define% VIDEO_FRAMES    6520

%define% AUDIO_RATE           22050
%define% AUDIO_CHUNK_SAMPLES  1470        ; 2 video frames worth
%define% AUDIO_CHUNK_BYTES    5880        ; 1470 * 4
%define% AUDIO_BDL_ENTRIES    32
%define% AUDIO_BDL_FILL       31          ; slots to fill per refill (32-1 gap)
%define% AUDIO_BDL_MASK       0x1F
%define% AUDIO_TOTAL_CHUNKS   3260        ; ceil(6520 frames / 2)

section .data
    badapple_bitmap df "../vid.bitmask"
    badapple_audio  df "../audio.raw"
%ifdef% BENCHMARK
    result_msg db "Timer Ticks: \0"
%endif%

%ifdef% FULL
_timer_handler:
    iret
%endif%

_start:
    ldq r0, MCSIZE
    sub r0, 8
    mov sp, r0

%ifdef% BENCHMARK
    bl _put_init
    stw gui_line, 0

    stq TIMER_COMPARE, 0xFFFFFFFFFFFFFFFF
    stq TIMER_CTRL, 0x7
%endif%

%ifdef% FULL
    bl _pmm_init
    bl _interrupt_init
%endif%
%ifdef% BENCHMARK
    bl _pmm_init
    bl _interrupt_init
%endif%

%ifdef% FULL
    blw _interrupt_register_handler, IRQ_TIMER, _timer_handler

    ldq r0, TIMER_FREQ
    div r0, 30
    stq TIMER_COMPARE, r0
    stq TIMER_COUNT, 0
    stq TIMER_CTRL, 0x7
%endif%

    ldb r0, FB_ENABLED
    bz r0, .end

    ldw r10, FB_WIDTH

.video_entry:
    add r1, FB_FRAMEBUFFER, VFB_SIZE

.video_playback:
    mov r2, badapple_bitmap
    mov r5, 0
.video_frame_next:
%ifdef% FULL
    hlt
%endif%

    cmp r5, VIDEO_FRAMES
%ifdef% BENCHMARK
    bgt .end
%else%
    bgt .video_playback
%endif%
    mov r0, FB_FRAMEBUFFER

.video_frame_draw:
    ldb r3, r2
    pdep r4, r3, 0x0101010101010101
    mul r4, 0xFF
    bswapq r4

%if% VFB_ENABLED
    sub r11, r0, FB_FRAMEBUFFER
    shr r12, r11, 8
    and r14, r11, 0xFF
    mul r15, r12, r10
    add r15, r14
    add r15, FB_FRAMEBUFFER
    stq r15, r4
%else%
    stq r0, r4
%endif%

    add r0, 8
    inc r2

    cmp r0, r1
    blt .video_frame_draw
    inc r5
    b .video_frame_next

.end:
%ifdef% BENCHMARK
    ldq r0, TIMER_COUNT
    blw _puts, result_msg
    blw _putbase, r0, 10
    blw _putc, ' '
    blw _putc, '('
    ldq r0, TIMER_FREQ
    blw _putbase, r0, 10
    blw _putc, 'H'
    blw _putc, 'Z'
    blw _putc, ')'
    blw _putc, '\n'

.no_end:
    hlt
    b .no_end
%endif%
    stb PLATFORM_PWR, 0
