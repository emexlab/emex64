%include% <arch/uart.e64inc>
%include% <arch/platform.e64inc>

section .data
    msg db "hello, world!\n\0"

_start:
    mov r3, EMEX64_UART_REG_DATA
    mov r0, msg
.loop:
    ldb r1, r0++
.retry:
    ldq r2, [r3 + 8]
    and r2, EMEX64_UART_STATUS_TX_EMPTY
    bz r2, .retry
    stq r3, r1
    bnz r1, .loop
.end:
    stq [r3 + 0x4000], 0
