+static void AddEmex64TargetArgs(const ToolChain &TC, const ArgList &Args,
+                                ArgStringList &CmdArgs) {
+  const Driver &D = TC.getDriver();
+  StringRef Scope =
+      TC.getEffectiveTriple().isEmex64e() ? "non-leaf" : "none";
+  if (const Arg *A = Args.getLastArg(options::OPT_mbranch_protection_EQ,
+                                     options::OPT_msign_return_address_EQ)) {
+    StringRef Value = A->getValue();
+    if (A->getOption().matches(options::OPT_msign_return_address_EQ) &&
+        (Value == "none" || Value == "non-leaf" || Value == "all"))
+      Scope = Value;
+    else if (Value == "none")
+      Scope = "none";
+    else if (Value == "standard" || Value == "pac-ret")
+      Scope = "non-leaf";
+    else if (Value == "pac-ret+leaf")
+      Scope = "all";
+    else
+      D.Diag(diag::err_drv_unsupported_option_argument)
+          << A->getSpelling() << Value;
+  }
+  if (Scope != "none") {
+    CmdArgs.push_back(
+        Args.MakeArgString(Twine("-msign-return-address=") + Scope));
+    CmdArgs.push_back("-msign-return-address-key=a_key");
+  }
+}
