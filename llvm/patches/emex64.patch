+static bool supportsEmex64(uint64_t Type) {
+  switch (Type) {
+  case ELF::R_EMEX64_NONE:
+  case ELF::R_EMEX64_ABS64:
+  case ELF::R_EMEX64_ABS32:
+  case ELF::R_EMEX64_PC64:
+  case ELF::R_EMEX64_PC32:
+  case ELF::R_EMEX64_DTPOFF64:
+    return true;
+  default:
+    return false;
+  }
+}
+
+static uint64_t resolveEmex64(uint64_t Type, uint64_t Offset, uint64_t S,
+                              uint64_t LocData, int64_t Addend) {
+  switch (Type) {
+  case ELF::R_EMEX64_NONE:
+    return LocData;
+  case ELF::R_EMEX64_ABS64:
+  case ELF::R_EMEX64_DTPOFF64:
+    return S + Addend;
+  case ELF::R_EMEX64_ABS32:
+    return (S + Addend) & 0xFFFFFFFF;
+  case ELF::R_EMEX64_PC64:
+    return S + Addend - Offset;
+  case ELF::R_EMEX64_PC32:
+    return (S + Addend - Offset) & 0xFFFFFFFF;
+  default:
+    llvm_unreachable("Invalid relocation type");
+  }
+}
