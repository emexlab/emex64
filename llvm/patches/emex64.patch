+#if defined(_LIBUNWIND_TARGET_EMEX64)
+class _LIBUNWIND_HIDDEN Registers_emex64 {
+public:
+  Registers_emex64();
+  Registers_emex64(const void *registers);
+
+  typedef uint64_t reg_t;
+  typedef uint64_t link_reg_t;
+  typedef const link_reg_t &link_hardened_reg_arg_t;
+
+  bool        validRegister(int num) const;
+  uint64_t    getRegister(int num) const;
+  void        setRegister(int num, uint64_t value);
+  bool        validFloatRegister(int num) const;
+  double      getFloatRegister(int num) const;
+  void        setFloatRegister(int num, double value);
+  bool        validVectorRegister(int num) const;
+  v128        getVectorRegister(int num) const;
+  void        setVectorRegister(int num, v128 value);
+  static const char *getRegisterName(int num);
+  void        jumpto();
+  static constexpr int lastDwarfRegNum() {
+    return _LIBUNWIND_HIGHEST_DWARF_REGISTER_EMEX64;
+  }
+  static int  getArch() { return REGISTERS_EMEX64; }
+
+  uint64_t  getSP() const         { return _registers[UNW_EMEX64_SP]; }
+  void      setSP(uint64_t value) { _registers[UNW_EMEX64_SP] = value; }
+  uint64_t  getIP() const         { return _registers[UNW_EMEX64_PC]; }
+  void      setIP(uint64_t value) { _registers[UNW_EMEX64_PC] = stripPAC(value); }
+
+private:
+  static uint64_t stripPAC(uint64_t value) { return value & ~(0x3FFULL << 54); }
+
+  uint64_t _registers[_LIBUNWIND_HIGHEST_DWARF_REGISTER_EMEX64 + 1];
+};
+
+inline Registers_emex64::Registers_emex64(const void *registers) {
+  static_assert((check_fit<Registers_emex64, unw_context_t>::does_fit),
+                "emex64 registers do not fit into unw_context_t");
+  memcpy(&_registers, registers, sizeof(_registers));
+}
+
+inline Registers_emex64::Registers_emex64() {
+  memset(&_registers, 0, sizeof(_registers));
+}
+
+inline bool Registers_emex64::validRegister(int regNum) const {
+  if (regNum == UNW_REG_IP || regNum == UNW_REG_SP)
+    return true;
+  return regNum >= UNW_EMEX64_PC && regNum <= UNW_EMEX64_ER15;
+}
+
+inline uint64_t Registers_emex64::getRegister(int regNum) const {
+  if (regNum == UNW_REG_IP)
+    return _registers[UNW_EMEX64_PC];
+  if (regNum == UNW_REG_SP)
+    return _registers[UNW_EMEX64_SP];
+  if (regNum >= UNW_EMEX64_PC && regNum <= UNW_EMEX64_FR15)
+    return _registers[regNum];
+  _LIBUNWIND_ABORT("unsupported emex64 register");
+}
+
+inline void Registers_emex64::setRegister(int regNum, uint64_t value) {
+  if (regNum == UNW_REG_IP || regNum == UNW_EMEX64_PC)
+    _registers[UNW_EMEX64_PC] = stripPAC(value);
+  else if (regNum == UNW_REG_SP)
+    _registers[UNW_EMEX64_SP] = value;
+  else if (regNum >= UNW_EMEX64_PC && regNum <= UNW_EMEX64_FR15)
+    _registers[regNum] = value;
+  else
+    _LIBUNWIND_ABORT("unsupported emex64 register");
+}
+
+inline bool Registers_emex64::validFloatRegister(int regNum) const {
+  return regNum >= UNW_EMEX64_FR0 && regNum <= UNW_EMEX64_FR15;
+}
+
+inline double Registers_emex64::getFloatRegister(int regNum) const {
+  assert(validFloatRegister(regNum));
+  double d;
+  memcpy(&d, &_registers[regNum], sizeof(d));
+  return d;
+}
+
+inline void Registers_emex64::setFloatRegister(int regNum, double value) {
+  assert(validFloatRegister(regNum));
+  memcpy(&_registers[regNum], &value, sizeof(value));
+}
+
+inline bool Registers_emex64::validVectorRegister(int) const { return false; }
+
+inline v128 Registers_emex64::getVectorRegister(int) const {
+  _LIBUNWIND_ABORT("emex64 has no vector registers");
+}
+
+inline void Registers_emex64::setVectorRegister(int, v128) {
+  _LIBUNWIND_ABORT("emex64 has no vector registers");
+}
+
+inline const char *Registers_emex64::getRegisterName(int regNum) {
+  static const char *const names[] = {
+      "pc",   "sp",   "fp",   "cf",   "fpc",  "r0",   "r1",   "r2",
+      "r3",   "r4",   "r5",   "r6",   "r7",   "r8",   "r9",   "rr",
+      "er0",  "er1",  "er2",  "er3",  "er4",  "er5",  "er6",  "er7",
+      "er8",  "er9",  "er10", "er11", "er12", "er13", "er14", "er15",
+      "fr0",  "fr1",  "fr2",  "fr3",  "fr4",  "fr5",  "fr6",  "fr7",
+      "fr8",  "fr9",  "fr10", "fr11", "fr12", "fr13", "fr14", "fr15"};
+  if (regNum == UNW_REG_IP)
+    return "pc";
+  if (regNum == UNW_REG_SP)
+    return "sp";
+  if (regNum >= 0 && regNum <= UNW_EMEX64_FR15)
+    return names[regNum];
+  return "unknown register";
+}
+#endif /* _LIBUNWIND_TARGET_EMEX64 */
+
 } // namespace libunwind
 
 #endif // __REGISTERS_HPP__
