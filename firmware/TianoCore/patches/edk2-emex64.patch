+STATIC
+UINT32
+Emex64ReadField32 (
+  UINT8   *Targ,
+  UINT32  Shift
+  )
+{
+  UINT64  Bits;
+
+  Bits = (UINT64)Targ[0] | ((UINT64)Targ[1] << 8) | ((UINT64)Targ[2] << 16) | ((UINT64)Targ[3] << 24) | ((UINT64)Targ[4] << 32);
+  return (UINT32)(Bits >> Shift);
+}
+
+STATIC
+VOID
+Emex64WriteField32 (
+  UINT8   *Targ,
+  UINT32  Shift,
+  UINT32  Value
+  )
+{
+  UINT64  Bits;
+  UINT64  Mask;
+  UINT32  Index;
+
+  Bits = (UINT64)Targ[0] | ((UINT64)Targ[1] << 8) | ((UINT64)Targ[2] << 16) | ((UINT64)Targ[3] << 24) | ((UINT64)Targ[4] << 32);
+  Mask = (UINT64)0xFFFFFFFF << Shift;
+  Bits = (Bits & ~Mask) | (((UINT64)Value << Shift) & Mask);
+  for (Index = 0; Index < 5; Index++) {
+    Targ[Index] = (UINT8)(Bits >> (8 * Index));
+  }
+}
+
+STATIC
+VOID
+WriteSectionEmex64 (
+  Elf_Rela  *Rel,
+  UINT8     *Targ,
+  Elf_Shdr  *SymShdr,
+  Elf_Sym   *Sym,
+  UINT32    SecOffset,
+  Elf_Shdr  *SecShdr
+  )
+{
+  INT64   SymDelta;
+  INT64   PcDelta;
+  UINT32  Shift;
+
+  SymDelta = (INT64)mCoffSectionsOffset[Sym->st_shndx] - (INT64)SymShdr->sh_addr;
+  PcDelta  = (INT64)SecOffset - (INT64)SecShdr->sh_addr;
+
+  switch (ELF_R_TYPE (Rel->r_info)) {
+  case R_EMEX64_NONE:
+    break;
+  case R_EMEX64_ABS64:
+    *(UINT64 *)Targ = *(UINT64 *)Targ + SymDelta;
+    break;
+  case R_EMEX64_ABS32:
+    *(UINT32 *)Targ = (UINT32)(*(UINT32 *)Targ + SymDelta);
+    break;
+  case R_EMEX64_PC64:
+    *(UINT64 *)Targ = *(UINT64 *)Targ + SymDelta - PcDelta;
+    break;
+  case R_EMEX64_PC32:
+    *(UINT32 *)Targ = (UINT32)(*(UINT32 *)Targ + SymDelta - PcDelta);
+    break;
+  case R_EMEX64_BRANCH32:
+  case R_EMEX64_PLT32:
+  case R_EMEX64_BRANCH32_B4:
+  case R_EMEX64_PLT32_B4:
+    Shift = (ELF_R_TYPE (Rel->r_info) == R_EMEX64_BRANCH32_B4 || ELF_R_TYPE (Rel->r_info) == R_EMEX64_PLT32_B4) ? 4 : 0;
+    Emex64WriteField32 (Targ, Shift, (UINT32)(Emex64ReadField32 (Targ, Shift) + SymDelta - PcDelta));
+    break;
+  default:
+    Error (NULL, 0, 3000, "Invalid", "WriteSections64(): %s unsupported ELF EM_EMEX64 relocation 0x%x (build with -fno-pic and hidden visibility).", mInImageName, (unsigned) ELF_R_TYPE(Rel->r_info));
+  }
+}
