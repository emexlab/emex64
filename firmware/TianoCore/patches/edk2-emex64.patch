+EFI_STATUS
+UpdateEmex64ResetVectorIfNeeded (
+  MEMORY_FILE            *FvImage,
+  FV_INFO                *FvInfo
+  )
+
+{
+  EFI_STATUS                Status;
+  EFI_FILE_SECTION_POINTER  SecPe32;
+  EFI_PHYSICAL_ADDRESS      SecCoreEntryAddress;
+  UINT16                    MachineType;
+  UINT8                     *Vector;
+  UINT32                    Index;
+
+  if (FvImage == NULL || FvInfo == NULL) {
+    return EFI_INVALID_PARAMETER;
+  }
+
+  InitializeFvLib (FvImage->FileImage, FvInfo->Size);
+
+  Status = FindCorePeSection (FvImage->FileImage, FvInfo->Size, EFI_FV_FILETYPE_SECURITY_CORE, &SecPe32);
+  if (EFI_ERROR (Status)) {
+    return EFI_SUCCESS;
+  }
+
+  Status = GetCoreMachineType (SecPe32, &MachineType);
+  if (EFI_ERROR (Status) || MachineType != IMAGE_FILE_MACHINE_EMEX64) {
+    Error (NULL, 0, 3000, "Invalid", "Could not update SEC core because Machine type is not emex64.");
+    return EFI_ABORTED;
+  }
+
+  Status = GetCoreEntryPointAddress (FvImage->FileImage, FvInfo, SecPe32, &SecCoreEntryAddress);
+  if (EFI_ERROR (Status)) {
+    Error (NULL, 0, 3000, "Invalid", "Could not get the PE32 entry point address for SEC Core.");
+    return EFI_ABORTED;
+  }
+
+  VerboseMsg ("UpdateEmex64ResetVectorIfNeeded: SEC entry at 0x%llX", (unsigned long long) SecCoreEntryAddress);
+
+  Vector = (UINT8 *)FvImage->FileImage;
+  memset (Vector, 0, 16);
+  Vector[0] = 0x26;
+  Vector[1] = 0x07;
+  for (Index = 0; Index < 8; Index++) {
+    Vector[2 + Index] = (UINT8)(SecCoreEntryAddress >> (8 * Index));
+  }
+
+  return EFI_SUCCESS;
+}
